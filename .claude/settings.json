{
  "enabledPlugins": {
    "oh-my-claudecode@omc": false,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$(git rev-parse --show-toplevel)/governance/check_all.sh\"",
            "timeout": 60,
            "statusMessage": "Running governance gates..."
          }
        ]
      }
    ]
  }
}
